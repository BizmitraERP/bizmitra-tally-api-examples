# Copy to .env and fill in. Never commit the filled-in file.
# https://docs.bizmitra.io/developer/api/authentication

BIZMITRA_KEY_ID=
BIZMITRA_SECRET=

# The Bizmitra Developer Company ID — NOT a Tally company GUID.
# https://docs.bizmitra.io/developer/api/authentication#identifying-the-company
#
# This server is scoped to exactly this company. It is read here, on purpose,
# so that no tool argument can ever point it at a different customer's books.
BIZMITRA_COMPANY_ID=

# Optional. Defaults to https://bizmitra.io
# BIZMITRA_BASE_URL=https://bizmitra.io

# Writes are off by default. Set to exactly "true" to register
# tally_create_invoice, which writes into real books with no undo.
# Use a dedicated Tally test company.
BIZMITRA_ENABLE_WRITES=false
